<?xml version="1.0" encoding="utf-8"?>
<!--
  A progress ring, three quarters closed — the same shape the app draws for the fluid and macro
  charts, so the icon states what the app is for without spelling out a word.

  Geometry sits inside the adaptive-icon safe zone (the centre 66dp of the 108dp viewport): centred
  at 54,54 with radius 27 and a 9dp stroke, so the ring survives the circle, squircle and rounded
  masks launchers apply without clipping.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Track: the part still open. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,27 A27,27 0 1 1 54,81 A27,27 0 1 1 54,27"
        android:strokeAlpha="0.28"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9" />
    <!-- Progress: 270° clockwise from the top, rounded so the leading end reads as a position. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,27 A27,27 0 1 1 27,54"
        android:strokeColor="#9DC2FF"
        android:strokeLineCap="round"
        android:strokeWidth="9" />
</vector>
